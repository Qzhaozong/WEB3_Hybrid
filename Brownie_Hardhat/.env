# ===================== 本地网络配置（hardhat/localhost） =====================
# Hardhat 内置测试账户地址（从 npx hardhat accounts 复制）
LOCAL_DEPLOYER_ADDRESS=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266

# ===================== 公网配置（Sepolia/主网） =====================
# 部署者私钥（公网必须用私钥，地址由私钥推导）
DEPLOYER_PRIVATE_KEY=你的公网钱包私钥（64位十六进制，无0x前缀也可）
# Infura/Alchemy API Key（公网RPC用）
INFURA_API_KEY=你的Infura API Key
# Etherscan API Key（可选，验证合约用）
ETHERSCAN_API_KEY=你的Etherscan API Key